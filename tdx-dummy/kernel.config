# GCP PCI Hotplug Support
CONFIG_HOTPLUG_PCI_ACPI=y
CONFIG_HOTPLUG_PCI_ACPI_IBM=y
CONFIG_ACPI_PCI_SLOT=y

# Additional ACPI support for GCP
CONFIG_ACPI_HOTPLUG_MEMORY=y
CONFIG_ACPI_CONTAINER=y

# Ensure virtio-pci works properly
CONFIG_VIRTIO_PCI_LEGACY=y

# Google Virtual NIC (gVNIC) support - MUST be built-in, not module
CONFIG_GVE=y
CONFIG_NET_VENDOR_GOOGLE=y

# Ensure VIRTIO is also built-in as fallback
CONFIG_VIRTIO_NET=y
CONFIG_VIRTIO_PCI=y

# Network driver debugging (can be removed later)
CONFIG_NETCONSOLE=y
CONFIG_NETPOLL=y